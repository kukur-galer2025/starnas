# =====================================================================
# TEMPLATE .env PRODUCTION - STARNAS ASASI & ICoABCD 2026
# Salin ke server sebagai ".env", lalu isi semua nilai <ISI_...>.
# JANGAN commit file .env asli (berisi rahasia).
# =====================================================================

# ===============================
# APLIKASI
# ===============================
APP_NAME="STARNAS ASASI & ICoABCD 2026"
APP_ENV=production
# PENTING: pertahankan APP_KEY yang sudah ada di server. Jangan diganti
# (mengganti membuat sesi login aktif tidak valid). Jika kosong: php artisan key:generate
APP_KEY=<PERTAHANKAN_YANG_SUDAH_ADA>
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://starnas.asasi.or.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ===============================
# LOG
# ===============================
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ===============================
# DATABASE (CloudPanel MySQL)
# ===============================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<ISI_NAMA_DATABASE>
DB_USERNAME=<ISI_USER_DATABASE>
DB_PASSWORD=<ISI_PASSWORD_DATABASE_YANG_KUAT>

# ===============================
# SESSION, CACHE, QUEUE
# ===============================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie hanya dikirim lewat HTTPS
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
# Email dikirim setelah respons (afterResponse), tidak butuh queue worker
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# ===============================
# EMAIL (Gmail SMTP)
# ===============================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=amaniaevent@gmail.com
MAIL_PASSWORD=<ISI_APP_PASSWORD_GMAIL_16_KARAKTER>
MAIL_FROM_ADDRESS=amaniaevent@gmail.com
MAIL_FROM_NAME="STARNAS ASASI"

# --- Alternatif: email domain sendiri (Hostinger Business Email) ---
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_ENCRYPTION=ssl
# MAIL_USERNAME=icoabcd@asasi.or.id
# MAIL_PASSWORD=<password mailbox>
# MAIL_FROM_ADDRESS=icoabcd@asasi.or.id

# ===============================
# GOOGLE OAUTH
# Redirect URI ini HARUS terdaftar di Google Cloud Console.
# ===============================
GOOGLE_CLIENT_ID=<ISI_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<ISI_GOOGLE_CLIENT_SECRET>
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

VITE_APP_NAME="${APP_NAME}"
